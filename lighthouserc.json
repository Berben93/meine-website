{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": [
        "http://localhost/index.html",
        "http://localhost/anfrage.html",
        "http://localhost/kernlochrechner.html",
        "http://localhost/schnittwerte-rechner.html",
        "http://localhost/referenz-titan-op-werkzeuge.html",
        "http://localhost/karriere.html",
        "http://localhost/en/index.html",
        "http://localhost/en/knowledge-fits.html"
      ],
      "numberOfRuns": 1,
      "settings": { "chromeFlags": "--no-sandbox" }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.85 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci/berichte" }
  }
}
