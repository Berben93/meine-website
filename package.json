{
  "name": "website-berben",
  "private": true,
  "description": "Website der Berben Engineering GmbH",
  "scripts": {
    "build": "tailwindcss -i src/styles.css -o assets/css/styles.css --minify",
    "watch": "tailwindcss -i src/styles.css -o assets/css/styles.css --watch",
    "check:links": "node scripts/check-links.mjs",
    "check:html": "html-validate \"*.html\" \"en/*.html\"",
    "check:lighthouse": "lhci autorun",
    "check": "npm run check:links && npm run check:html"
  },
  "devDependencies": {
    "@lhci/cli": "0.14.0",
    "html-validate": "9.7.1",
    "tailwindcss": "3.4.17"
  }
}
